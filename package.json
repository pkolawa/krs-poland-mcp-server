{
  "mcpName": "io.github.pkolawa/krs-poland-mcp-server",
  "name": "krs-poland-mcp-server",
  "version": "1.4.0",
  "description": "The MCP server for KRS Poland public API.",
  "main": "./build/index.mjs",
  "scripts": {
    "build": "npm run test:unit && node build.mjs",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest --testPathIgnorePatterns=api.integration.test.ts",
    "test:integration": "jest --runTestsByPath src/utils/api.integration.test.ts",
    "typecheck": "tsc --noEmit",
    "version": "node scripts/sync-version.mjs && git add src/server.ts server.json",
    "prepublishOnly": "node scripts/preflight.mjs && npm run lint && npm run typecheck && npm run build && node scripts/verify-artifact.mjs",
    "postpublish": "node scripts/postpublish.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pkolawa/krs-poland-mcp-server.git"
  },
  "keywords": [
    "mcp",
    "poland",
    "krs",
    "server"
  ],
  "author": {
    "name": "Piotr Kolawa",
    "email": "p.kolawa@gmail.com"
  },
  "license": "MIT",
  "files": [
    "build/index.mjs"
  ],
  "type": "module",
  "bin": {
    "krs-poland-mcp-server": "build/index.mjs"
  },
  "bugs": {
    "url": "https://github.com/pkolawa/krs-poland-mcp-server/issues"
  },
  "homepage": "https://github.com/pkolawa/krs-poland-mcp-server#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.1",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "esbuild": "^0.25.9",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^30.5.2",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.2"
  }
}
